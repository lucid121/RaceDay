@model RaceDay.Web.Models.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-4 p-4">
                <div class="card-body">
                    <h1 class="text-danger fw-bold display-4 mb-3">Oops!</h1>
                    <h3 class="text-secondary mb-4">An error occurred while processing your request.</h3>

                    <p class="text-muted mb-4">
                        Something went wrong on our end. Please try again or head back to the home page.
                    </p>

                    @if (Model?.ShowRequestId ?? false)
                    {
                        <div class="bg-light p-2 rounded mb-4 d-inline-block">
                            <small class="text-secondary"><strong>Request ID:</strong> <code>@Model.RequestId</code></small>
                        </div>
                    }

                    <div class="d-flex justify-content-center gap-2">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 py-2 rounded-pill">
                            Back to Home
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>